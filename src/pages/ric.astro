---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ricImage from '../assets/ric.jpg';

const title = 'Le R.I.C. — Gilets Jaunes 2026';
const description = 'Découvrez le Référendum d’Initiative Citoyenne et les quatre formes de R.I.C. portées par Gilets Jaunes 2026.';
---
<BaseLayout title={title} description={description}>
  <header class="fixed inset-x-0 top-0 z-20 border-b border-white/10 bg-night/80 backdrop-blur-xl">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4" aria-label="Navigation principale">
      <a href="/" class="flex items-center gap-3 font-display text-sm font-bold tracking-tight"><span class="h-3 w-3 rounded-full bg-signal shadow-[0_0_14px_#eab308]" aria-hidden="true"></span>GILETS JAUNES <span class="text-signal">2026</span><span class="french-flag" role="img" aria-label="Drapeau français"><span></span><span></span><span></span></span></a>
      <div class="hidden items-center gap-7 text-sm text-zinc-400 md:flex"><a class="transition hover:text-white" href="/#manifeste">Manifeste</a><a class="transition hover:text-white" href="/#revendications">Revendications</a><a class="transition hover:text-white" href="/#soutenir">Soutenir</a></div>
      <a href="/" class="rounded-full border border-signal/60 px-4 py-2 text-xs font-bold text-signal transition hover:bg-signal hover:text-night">Retour à l’accueil</a>
    </nav>
  </header>
  <main class="min-h-screen px-6 pb-20 pt-32">
    <section class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[.22em] text-signal">Démocratie directe</p>
        <h1 class="font-display text-5xl font-bold leading-[.95] tracking-[-.05em] sm:text-7xl">Exigeons<br /><span class="text-signal">le R.I.C.</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">Référendum d’initiative citoyenne : c’est quoi, à quoi ça sert, comment ça marche.</p><p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-500">Affiche de la Coordination nationale des Gilets jaunes.</p><a href={ricImage.src} download="gilets-jaunes-2026-ric.jpg" class="mt-7 inline-flex items-center gap-2 rounded-full bg-signal px-5 py-3 text-sm font-bold text-night transition hover:bg-yellow-300 focus:outline-none focus:ring-2 focus:ring-signal focus:ring-offset-2 focus:ring-offset-night">Télécharger l’affiche <span aria-hidden="true">↓</span></a><p class="mt-3 text-xs text-zinc-600">Image originale en haute définition, téléchargée au format JPG.</p>
      </div>
      <figure class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[.03] shadow-2xl shadow-black/40">
        <Image src={ricImage} alt="Infographie présentant le Référendum d’Initiative Citoyenne, ses quatre formes et ses étapes" widths={[480, 768, 1024, 1280]} sizes="(max-width: 640px) 100vw, (max-width: 1280px) 90vw, 1280px" format="webp" quality={82} loading="eager" class="ric-image mx-auto h-auto w-full max-w-5xl" /><img src={ricImage.src} alt="" class="ric-print-image" aria-hidden="true" />
        <figcaption class="border-t border-white/10 px-5 py-4 text-sm text-zinc-500 sm:px-8">Le R.I.C. : un outil de démocratie directe au service de l’initiative citoyenne.</figcaption>
      </figure>
    </section>
  </main>
  <script>
    document.querySelector<HTMLButtonElement>('[data-download-ric]')?.addEventListener('click', () => window.print());
  </script>
  <footer class="border-t border-white/10 px-6 py-8"><div class="mx-auto flex max-w-7xl flex-col justify-between gap-5 text-sm text-zinc-500 sm:flex-row sm:items-center"><p>© 2026 Gilets Jaunes 2026. Le pouvoir au peuple.</p><a href="/" class="transition hover:text-signal">Accueil</a></div></footer>
</BaseLayout>
<style>
  @media (prefers-reduced-motion: no-preference) {
    main { animation: page-in 420ms ease-out both; }
  }
  @keyframes page-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.french-flag { display: inline-flex; width: 24px; height: 16px; overflow: hidden; border-radius: 2px; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.2); } .french-flag span { flex: 1; } .french-flag span:first-child { background: #1d4ed8; } .french-flag span:nth-child(2) { background: #fff; } .french-flag span:last-child { background: #ef4444; } .ric-print-image { display: none; } @media print { @page { size: A4 portrait; margin: 0; } body { background: #fff !important; } header, footer, figcaption, .ric-image, [data-download-ric], main > section > div > div:first-child p, main > section > div > div:first-child h1 { display: none !important; } main { min-height: 0 !important; padding: 0 !important; } main > section, main > section > div, figure { display: block !important; max-width: none !important; margin: 0 !important; padding: 0 !important; border: 0 !important; box-shadow: none !important; } .ric-print-image { display: block; width: 100%; height: auto; } }\n</style>
